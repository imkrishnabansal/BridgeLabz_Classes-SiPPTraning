INTERFACE PaymentMethod\
    METHOD id()\
    METHOD validate()\
\
CLASS UPI IMPLEMENTS PaymentMethod\
    ATTRIBUTES: upiId\
    METHOD validate(): check if upiId contains "@"\
\
CLASS Card IMPLEMENTS PaymentMethod\
    ATTRIBUTES: number, holder, expiry\
    METHOD validate(): check if number length >= 12 AND expiry not null\
\
CLASS NetBanking IMPLEMENTS PaymentMethod\
    ATTRIBUTES: bankCode, customerId\
    METHOD validate(): check if fields not empty\
\
CLASS Transaction<T extends PaymentMethod>\
    ATTRIBUTES: txnId, method, amount, status\
    METHOD authorize()\
        IF amount > 0 AND method.validate() THEN status = AUTHORIZED ELSE FAILED\
    METHOD settle()\
        IF status == AUTHORIZED THEN status = SETTLED ELSE FAILED\
\
MAIN:\
    CREATE Transaction with UPI\
    AUTHORIZE + SETTLE\
\
    CREATE Transaction with Card\
    AUTHORIZE + SETTLE\
\
    CREATE Transaction with NetBanking (with invalid amount)\
    AUTHORIZE + SETTLE\
\
