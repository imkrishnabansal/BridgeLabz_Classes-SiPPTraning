INTERFACE Searchable\
    METHOD matches(query) RETURNS boolean\
\
INTERFACE Printable\
    METHOD print()\
\
ABSTRACT CLASS Report IMPLEMENTS Searchable, Printable\
    ATTRIBUTES: patientId, title\
    METHOD matches(query):\
        RETURN true if query found in patientId or title\
\
CLASS LabReport EXTENDS Report\
    ATTRIBUTES: testName, result\
    METHOD print(): PRINT lab report details\
\
CLASS ImagingReport EXTENDS Report\
    ATTRIBUTES: modality, impression\
    METHOD print(): PRINT imaging report details\
\
MAIN:\
    CREATE list of Report\
    ADD LabReport and ImagingReport objects\
    FOR each report in list\
        IF report.matches("searchTerm")\
            report.print()\
\
\
CLASS Patient\
    ATTRIBUTES: id, name, age\
\
CLASS PatientRecordManager\
    ATTRIBUTES: map (key=id, value=Patient)\
    METHOD add(patient)\
        PUT patient in map\
    METHOD get(id)\
        RETURN map[id]\
    METHOD update(id, newName, newAge)\
        FIND patient by id\
        IF found THEN update fields\
    METHOD delete(id)\
        REMOVE patient from map\
\
MAIN:\
    CREATE PatientRecordManager\
    ADD some patients\
    GET a patient by id\
    UPDATE a patient record\
    DELETE a patient record\
\
